# Server Configuration
PORT=3001
DATA_DIR=
GOOGLE_API_KEY=google_api_key_goes_here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openai/gpt-5
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=http://localhost:1234/v1
CUSTOM_AI_TEXT_MODEL=local-model
CUSTOM_AI_IMAGE_MODEL=
LIVEPEER_AGENT_API_KEY=
LIVEPEER_AGENT_URL=https://agent.livepeer.org/api/mcp/raw
LIVEPEER_AGENT_MODEL=flux-schnell
LIVEPEER_AGENT_TOOL_PROFILE=lean
# Optional deployment-side authorization for the Livepeer MCP demo/render path.
DEMO_RENDER_KEY=
MANGAGEN_MAX_ACTIVE_JOBS=2

# Model Routing
PLANNER_MODEL=gemini-3-flash-preview
CREATOR_FLASH_MODEL=gemini-3-flash-preview
CREATOR_PRO_MODEL=gemini-3-pro-preview

# Image Generation Models
CREATOR_IMAGE_MODEL_FLASH=gemini-2.5-flash-image
CREATOR_IMAGE_MODEL_PRO=gemini-3-pro-image-preview

# Optional Defaults
DEFAULT_GEN_MODE=full
DEFAULT_COLOR_MODE=bw
# Clean panel art is the default; dialogue/SFX are editable overlays.
DEFAULT_TEXT_DENSITY=minimal
DEFAULT_ASPECT_RATIO=portrait
DEFAULT_ART_STYLE=storybook_classic
